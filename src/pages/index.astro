---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import ClientsBand from '../components/home/ClientsBand.astro';
import ProjetStrip from '../components/home/ProjetStrip.astro';
import ReportShowcase from '../components/home/ReportShowcase.astro';
import About from '../components/home/About.astro';
import Steps from '../components/ui/Steps.astro';
import FinalCta from '../components/ui/FinalCta.astro';
import { FORFAIT_MAX_DAYS, RDV_DURATION_LABEL } from '../lib/site.const';
import { useLocale } from '../lib/i18n';

const { t, tjm, hourly } = useLocale(Astro.currentLocale);

const steps = [
  {
    title: `Un échange de ${RDV_DURATION_LABEL}`,
    text: "Vous m'expliquez le projet. Je vous dis comment je m'y prendrais, et si je suis le bon profil. C'est gratuit, même si je suis déjà en mission : on voit ensemble quand démarrer.",
  },
  {
    title: 'Un devis de démarrage',
    text: `On se teste sur un premier livrable, sur lequel je m'engage. ${FORFAIT_MAX_DAYS} jours maximum.`,
  },
  {
    title: 'La suite en régie',
    text: 'Si ça vous convient, on continue ensemble aussi longtemps que vous le souhaitez. En régie, facturée toutes les deux semaines.',
  },
];
---

<SiteLayout>
  <Hero />
  <ClientsBand />
  <ProjetStrip />
  <Steps
    id="demarrage"
    title={t('Comment on démarre', { 'fr-MU': 'Kouma nou komansé' })}
    steps={steps}
    footnote={`${tjm} ou ${hourly}. Temps plein ou partiel.`}
  />
  <ReportShowcase />
  <About />
  <FinalCta
    title={t('Un projet en attente ? Parlons-en 30 minutes.', {
      'fr-MU': 'Enn proze ki pe atann ? Nou kozé 30 minit.',
    })}
    place="home-final"
  />
</SiteLayout>

<script>
  import '../scripts/home';
</script>

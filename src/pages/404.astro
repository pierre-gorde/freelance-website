---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import PrimaryCta from '../components/ui/PrimaryCta.astro';
---

<SiteLayout title="Page introuvable" noindex={true}>
  <PageHero
    title="Cette page n'existe pas,"
    highlight="ou plus."
    lead="Vous pouvez revenir à l'accueil, ou réserver un échange si vous avez un projet en tête."
    tone="pale"
  >
    <div class="actions">
      <PrimaryCta size="lg" place="404" />
      <span data-notfound-home class="contents"
        ><a class="btn btn-lg btn-paper" href="/">Retour à l'accueil</a></span
      >
    </div>
  </PageHero>
</SiteLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 8px;
  }

  .contents {
    display: contents;
  }
</style>

<!-- La 404 est servie depuis le build FR pour toutes les routes, /mu/* inclus (un seul
     404.html sur Cloudflare Pages) : le clin d'oeil kreol se fait côté client. -->
<script>
  const MU_PREFIX = '/mu';
  const isMauritianPath =
    location.pathname === MU_PREFIX || location.pathname.startsWith(`${MU_PREFIX}/`);

  if (isMauritianPath) {
    const title = document.querySelector('main h1');
    if (title) title.textContent = 'Sa paz-la pa existé.';
    const lead = document.querySelector('main .lead');
    if (lead) {
      lead.textContent =
        'Pa grav. Ou kapav retourn lakaz, ouswa rézerv enn kozé si ou éna enn proze an tet.';
    }
    const homeLink = document.querySelector('[data-notfound-home] a');
    homeLink?.setAttribute('href', MU_PREFIX);
    if (homeLink) homeLink.textContent = 'Retourn lakaz';
  }
</script>

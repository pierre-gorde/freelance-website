---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { CONTACT_EMAIL, SITE_URL } from '../lib/site.const';

const sections = [
  {
    title: 'Éditeur du site',
    items: [
      { label: 'Nom', value: 'Pierre Gordé' },
      { label: 'Statut', value: 'Entrepreneur individuel (micro-entreprise)' },
      { label: 'SIRET', value: '824 998 587 00037' },
      { label: 'Code APE', value: '62.01Z, programmation informatique' },
      { label: 'Adresse', value: 'Bâtiment A, 93 rue Petit, 75019 Paris' },
      { label: 'Email', value: CONTACT_EMAIL },
      { label: 'Site', value: SITE_URL },
    ],
  },
  {
    title: 'Directeur de publication',
    items: [{ label: 'Responsable', value: 'Pierre Gordé' }],
  },
  {
    title: 'Hébergement',
    items: [
      { label: 'Prestataire', value: 'Cloudflare Pages' },
      { label: 'Société', value: 'Cloudflare, Inc.' },
      { label: 'Adresse', value: '101 Townsend St, San Francisco, CA 94107, États-Unis' },
      { label: 'Site', value: 'https://pages.cloudflare.com' },
    ],
  },
];
---

<SiteLayout
  title="Mentions légales"
  description="Mentions légales du site pierregorde.com."
  canonicalPath="/mentions-legales"
  noindex={true}
>
  <PageHero title="Mentions légales" />

  <div class="wrap legal">
    {
      sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <dl>
            {section.items.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    <section>
      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble du contenu de ce site (textes, illustrations, code) est la propriété de Pierre
        Gordé, sauf mention contraire. Toute reproduction, même partielle, est soumise à
        autorisation préalable.
      </p>
    </section>

    <section>
      <h2>Données personnelles</h2>
      <p>
        Ce site ne collecte aucune donnée personnelle directement. La prise de rendez-vous est gérée
        par Cal.com, dont la politique de confidentialité est disponible sur
        <a class="link" href="https://cal.com/privacy" target="_blank" rel="noopener noreferrer"
          >cal.com/privacy</a
        >.
      </p>
      <p>
        Les statistiques de fréquentation sont mesurées avec Umami, sans cookie et sans collecte de
        données personnelles. Conforme au RGPD, elle ne nécessite pas de bannière de consentement.
      </p>
    </section>
  </div>
</SiteLayout>

<style>
  .legal {
    display: grid;
    gap: 48px;
    max-width: 52rem;
    padding-block: var(--space-section);
  }

  h2 {
    font-size: 1.4rem;
    font-weight: 900;
    font-stretch: 112%;
  }

  dl {
    margin-top: 16px;
    border-top: var(--border);
  }

  dl div {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 4px 24px;
    padding-block: 12px;
    border-bottom: 2px solid var(--paper-2);
  }

  dt {
    font-weight: 800;
  }

  dd {
    margin: 0;
  }

  section p {
    margin-top: 16px;
    max-width: 65ch;
  }

  @media (max-width: 599px) {
    dl div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import FinalCta from '../../components/ui/FinalCta.astro';
import ProjetCard from '../../components/projets/ProjetCard.astro';
import { PROJETS } from '../../lib/projets.const';
import { useLocale } from '../../lib/i18n';

const { t } = useLocale(Astro.currentLocale);
---

<SiteLayout
  title="Projets livrés"
  description={`${PROJETS.length} missions livrées, de la FFTri pour les JO de Paris 2024 à Agregata AI : contexte, livrables, stack et schéma d'architecture pour chacune.`}
  canonicalPath="/projets"
>
  <PageHero
    title={t('Des projets', { 'fr-MU': 'Bann proze' })}
    highlight={t('livrés.', { 'fr-MU': 'livré.' })}
    lead={`${PROJETS.length} missions, de 2018 à aujourd'hui. Chaque fiche donne le contexte, ce que j'ai livré, la stack et un schéma d'architecture.`}
    tone="pale"
  />

  <section class="wrap projets" aria-label="Liste des projets">
    <ol class="projets-grid">
      {PROJETS.map((projet) => <ProjetCard projet={projet} headingLevel="h2" />)}
    </ol>
  </section>

  <FinalCta
    title={t('Un projet du même genre ? On en parle.', {
      'fr-MU': 'Ou éna enn proze parey ? Nou kozé.',
    })}
    place="projets-final"
  />
</SiteLayout>

<style>
  .projets {
    padding-block: var(--space-section);
  }

  .projets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 28px;
  }

  /* Cartes côte à côte : même hauteur. Empilées sur mobile : chacune sa hauteur. */
  @media (min-width: 800px) {
    .projets-grid {
      grid-auto-rows: 1fr;
    }
  }
</style>

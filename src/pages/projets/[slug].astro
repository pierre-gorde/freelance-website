---
import { Image, getImage } from 'astro:assets';

import SiteLayout from '../../layouts/SiteLayout.astro';
import FinalCta from '../../components/ui/FinalCta.astro';
import ProjetSchema from '../../components/projets/ProjetSchema.astro';
import { PROJETS, projetHostname, type Projet } from '../../lib/projets.const';
import { getProjetsStaticPaths } from '../../lib/projets.paths';
import { SITE_URL } from '../../lib/site.const';
import { useLocale } from '../../lib/i18n';

export const getStaticPaths = getProjetsStaticPaths;

type Props = { projet: Projet };

const OG_WIDTH = 1200;

const { t, l } = useLocale(Astro.currentLocale);
const { projet } = Astro.props;

const index = PROJETS.findIndex((entry) => entry.slug === projet.slug);
const prev = PROJETS[index - 1];
const next = PROJETS[index + 1];
const hostname = projetHostname(projet);
const ogImage = await getImage({ src: projet.capture, width: OG_WIDTH, format: 'jpg' });
---

<SiteLayout
  title={`${projet.titre} (${projet.secteur})`}
  description={projet.resume}
  canonicalPath={`/projets/${projet.slug}`}
  ogImage={new URL(ogImage.src, SITE_URL).href}
>
  <section
    class:list={['projet-hero', `tone-${projet.tone}`]}
    style={`view-transition-name: projet-${projet.slug}`}
  >
    <div class="wrap projet-hero-grid">
      <div class="projet-hero-copy">
        <a class="back" href={l('/projets')}
          >← {t('Tous les projets', { 'fr-MU': 'Tou bann proze' })}</a
        >
        <span class="stamp" data-stamp>{projet.stamp}</span>
        <h1
          class="display projet-title"
          style={`view-transition-name: projet-${projet.slug}-titre`}
        >
          {projet.titre}
        </h1>
        <p class="projet-meta">{projet.secteur} · {projet.periode}</p>
        <p class="lead">{projet.resume}</p>
        <p class="projet-fait">{projet.fait}</p>
      </div>
      <a
        class="site-card"
        href={projet.url}
        target="_blank"
        rel="noopener noreferrer"
        data-tilt="4,0"
      >
        <Image
          class="site-shot"
          src={projet.capture}
          alt={projet.captureAlt}
          widths={[480, 960, 1440]}
          sizes="(min-width: 900px) 560px, 100vw"
          loading="eager"
        />
        <span class="site-host">{hostname} ↗</span>
      </a>
    </div>
  </section>

  <section class="archi" aria-labelledby="archi-titre">
    <div class="wrap">
      <h2 class="display section-title" id="archi-titre" data-slam>
        {t("Vue d'ensemble technique", { 'fr-MU': 'Enn koudey teknik' })}
      </h2>
      <div class="archi-figure">
        <ProjetSchema
          schema={projet.schema}
          label={`Schéma d'architecture du projet ${projet.titre}`}
        />
      </div>
    </div>
  </section>

  <section class="detail" aria-label="Détail du projet" data-wipe="left">
    <div class="wrap detail-grid">
      <div>
        <h2 class="display detail-title" data-slam>{t('Contexte', { 'fr-MU': 'Kontex' })}</h2>
        <div data-rise><p class="detail-text">{projet.contexte}</p></div>
        <h2 class="display detail-title detail-title--stack" data-slam>Stack</h2>
        <ul class="stack-list" data-rise>
          {projet.stack.map((tag) => <li class="chip">{tag}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="display detail-title" data-slam>
          {t("Ce que j'ai livré", { 'fr-MU': 'Bann livrab' })}
        </h2>
        <ul class="livrables" data-rise>
          {projet.livrables.map((livrable) => <li>{livrable}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <nav class="wrap projet-nav" aria-label={t('Autres projets', { 'fr-MU': 'Lot bann proze' })}>
    {
      prev ? (
        <a class:list={['nav-card', `tone-${prev.tone}`]} href={l(`/projets/${prev.slug}`)}>
          <span>← {t('Précédent', { 'fr-MU': 'Avan' })}</span>
          <strong>{prev.titre}</strong>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a
          class:list={['nav-card', 'nav-card--next', `tone-${next.tone}`]}
          href={l(`/projets/${next.slug}`)}
        >
          <span>{t('Suivant', { 'fr-MU': 'Apré' })} →</span>
          <strong>{next.titre}</strong>
        </a>
      )
    }
  </nav>

  <FinalCta
    title={t('Un projet du même genre ? On en parle.', {
      'fr-MU': 'Ou éna enn proze parey ? Nou kozé.',
    })}
    place={`projet-${projet.slug}`}
  />
</SiteLayout>

<style>
  .projet-hero {
    border-bottom: var(--border);
  }

  .projet-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(28px, 4vw, 56px) clamp(48px, 6vw, 80px);
  }

  .projet-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .back {
    border: var(--border);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 800;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back:hover {
    background: var(--cyan-pale);
  }

  .projet-title {
    margin: 0;
    font-size: var(--text-h1);
  }

  .projet-meta {
    font-weight: 700;
  }

  .projet-fait {
    border: var(--border);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-md);
    font-weight: 800;
    font-size: 1.1rem;
  }

  .site-card {
    position: relative;
    display: block;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: var(--ink);
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }

  .site-card:hover {
    box-shadow: var(--shadow-xl);
  }

  .tone-ink .site-card {
    box-shadow: 6px 6px 0 var(--paper);
  }

  .site-shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .site-host {
    position: absolute;
    left: 12px;
    bottom: 12px;
    border: var(--border);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 800;
    font-size: var(--text-sm);
  }

  .archi {
    padding-block: var(--space-section);
  }

  .archi-figure {
    margin-top: 36px;
  }

  .detail {
    background: var(--paper-2);
    border-block: var(--border);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 40px clamp(32px, 6vw, 88px);
    padding-block: var(--space-section);
  }

  .detail-title {
    margin: 0;
    font-size: var(--text-h3);
  }

  .detail-title--stack {
    margin-top: 40px;
  }

  .detail-text {
    margin-top: 16px;
    font-size: 1.1rem;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .livrables {
    display: grid;
    gap: 12px;
    margin-top: 16px;
  }

  .livrables li {
    border: var(--border);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    font-weight: 600;
  }

  .projet-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 48px;
  }

  .nav-card {
    display: grid;
    gap: 4px;
    min-width: min(280px, 45%);
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    box-shadow: var(--shadow-md);
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .nav-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }

  .nav-card span {
    font-weight: 700;
  }

  .nav-card strong {
    font-weight: 900;
    font-stretch: 112%;
    font-size: 1.3rem;
  }

  .nav-card--next {
    text-align: right;
  }

  @media (max-width: 899px) {
    .projet-hero-grid,
    .detail-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card,
    .nav-card {
      transition: none;
    }
  }
</style>

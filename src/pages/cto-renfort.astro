---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import PrimaryCta from '../components/ui/PrimaryCta.astro';
import Engagements from '../components/ui/Engagements.astro';
import Steps from '../components/ui/Steps.astro';
import FaqSection from '../components/ui/FaqSection.astro';
import FinalCta from '../components/ui/FinalCta.astro';
import ProjetsSelection from '../components/projets/ProjetsSelection.astro';
import type { FaqId } from '../lib/faq.const';
import { FORFAIT_MAX_DAYS, RDV_DURATION_LABEL, SITE_ROLE } from '../lib/site.const';
import { useLocale } from '../lib/i18n';

const { t, l, tjm, hourly } = useLocale(Astro.currentLocale);

const engagements = [
  {
    title: "Je m'intègre sans vous ralentir",
    text: "Je lis le code avant d'en écrire et je suis vos conventions. Vous n'avez pas à m'expliquer comment fonctionne une pull request.",
  },
  {
    title: "J'avance seul, je reviens vers vous quand il faut",
    text: "Je prends les décisions techniques de mon périmètre. Quand un choix engage l'architecture, je vous le soumets.",
  },
  {
    title: 'Un compte-rendu écrit chaque soir',
    text: "Ce qui est mergé, ce qui bloque, ce que j'ai arbitré et pourquoi, ce qui suit. Votre équipe sait ce qui a été touché.",
  },
  {
    title: 'Un tarif clair',
    text: `${tjm} ou ${hourly}, à temps plein ou partiel. Vous savez à quoi a servi chaque jour.`,
  },
];

const journey = [
  {
    title: 'Un échange technique',
    duration: RDV_DURATION_LABEL,
    text: 'Votre stack, vos conventions, le chantier que vous avez en tête. Je vous pose les questions qui comptent.',
  },
  {
    title: 'Une lecture du code',
    duration: '1 à 2 jours',
    text: 'Si on est alignés, je lis la base de code avant de démarrer. Je reviens avec mes questions et une estimation du chantier.',
  },
  {
    title: 'Un chantier ciblé',
    duration: `Jusqu'à ${FORFAIT_MAX_DAYS} jours`,
    text: 'Une fonctionnalité, une migration, un connecteur. Vous voyez comment je travaille dans votre contexte.',
  },
  {
    title: 'La suite en régie',
    duration: tjm,
    text: 'Si ça convient des deux côtés, je reste sur le projet le temps nécessaire, avec le même compte-rendu.',
  },
];

const FAQ_IDS: readonly FaqId[] = [
  'demarrage',
  'temps-partiel',
  'pas-dispo',
  'integration',
  'brief',
  'equipe',
];
---

<SiteLayout
  title="Renfort pour chef de projet et CTO"
  description={`Votre roadmap déborde ? Seul ou avec votre équipe, je prends votre projet : outil interne, migration, connecteur, back-office. ${SITE_ROLE}, compte-rendu écrit chaque soir.`}
  canonicalPath="/cto-renfort"
>
  <PageHero
    title={t('Votre roadmap déborde ?')}
    highlight={t("Je prends le projet d'à côté.")}
    lead="Vous êtes chef de projet, CTO ou lead dev. Votre équipe avance sur le produit, et un autre chantier attend : outil interne, migration, connecteur, back-office. Je le prends en autonomie, dans votre stack."
  >
    <div class="actions">
      <PrimaryCta size="lg" place="cto-hero" magnet />
      <a class="link" href={l('/methode')}>{t('Voir ma méthode', { 'fr-MU': 'Get mo metod' })}</a>
    </div>
  </PageHero>

  <Engagements id="engagements" title="Ce qui change pour vous" items={engagements} />

  <ProjetsSelection
    title="Des chantiers de ce genre"
    slugs={['agregata', 'vouloir-dire', 'ublo']}
  />

  <Steps
    id="deroule"
    title={t('Comment ça se passe', { 'fr-MU': 'Kouma sa pasé' })}
    steps={journey}
    tone="plain"
  />

  <FaqSection ids={FAQ_IDS} />

  <FinalCta
    title={t('On parle du chantier ?', { 'fr-MU': 'Nou koz santié-la ?' })}
    text={`Vous décrivez le contexte, la stack et ce qui coince. Je vous dis si je suis le bon profil et comment je m'y prendrais. ${RDV_DURATION_LABEL}, gratuit.`}
    place="cto-final"
  />
</SiteLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 26px;
    margin-top: 8px;
  }
</style>

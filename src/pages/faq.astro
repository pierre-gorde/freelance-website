---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import FaqList from '../components/ui/FaqList.astro';
import FinalCta from '../components/ui/FinalCta.astro';
import { FAQ_GROUPS, getFaqEntries } from '../lib/faq.const';
import { useLocale } from '../lib/i18n';

const { t, l, tjm, hourly } = useLocale(Astro.currentLocale);
const entries = getFaqEntries({ tjm, hourly, l });
---

<SiteLayout
  title="Questions fréquentes"
  description="Démarrage, temps partiel, compte-rendu du soir, travail à distance, IA : les questions qu'on me pose avant de démarrer."
  canonicalPath="/faq"
>
  <PageHero
    title={t("Les questions qu'on me pose", { 'fr-MU': 'Bann kestion ki zot poz mwa' })}
    highlight={t('avant de démarrer.')}
    tone="pale"
  />

  <div class="wrap faq-page">
    {
      FAQ_GROUPS.map((group) => (
        <section class="faq-group" aria-labelledby={`faq-${group.ids[0]}`}>
          <h2 class="display faq-group-title" id={`faq-${group.ids[0]}`} data-slam>
            {group.title}
          </h2>
          <FaqList items={group.ids.map((id) => entries[id])} />
        </section>
      ))
    }
  </div>

  <FinalCta
    title={t('Une autre question ? On en parle.', { 'fr-MU': 'Enn lot kestion ? Nou kapav kozé.' })}
    place="faq-final"
  />
</SiteLayout>

<style>
  .faq-page {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
    padding-block: var(--space-section);
  }

  .faq-group {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 24px 48px;
    align-items: start;
  }

  .faq-group-title {
    margin: 0;
    font-size: var(--text-h3);
  }

  @media (max-width: 899px) {
    .faq-group {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

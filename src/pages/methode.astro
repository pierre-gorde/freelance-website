---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Steps from '../components/ui/Steps.astro';
import FinalCta from '../components/ui/FinalCta.astro';
import DailyReport from '../components/report/DailyReport.astro';
import { BLOCKED_REPORT, NOMINAL_REPORT } from '../lib/report.const';
import { DEVIS_DELAY_LABEL, FORFAIT_MAX_DAYS, RDV_DURATION_LABEL } from '../lib/site.const';
import { useLocale } from '../lib/i18n';

const { t, tjm, hourly } = useLocale(Astro.currentLocale);

const phases = [
  {
    title: 'Un premier échange',
    duration: RDV_DURATION_LABEL,
    text: "Vous me présentez le projet et son contexte. Je vous dis comment je m'y prendrais et si je suis le bon profil. Gratuit, quelle que soit la suite.",
  },
  {
    title: 'Un devis de démarrage',
    duration: DEVIS_DELAY_LABEL,
    text: "Si on est alignés, j'écris le périmètre, l'estimation et les jalons. S'il me manque des éléments pour cadrer, je vous le dis.",
  },
  {
    title: 'Le démarrage',
    duration: `Jusqu'à ${FORFAIT_MAX_DAYS} jours`,
    text: 'Un périmètre défini, une durée limitée. Vous voyez comment je travaille, je découvre votre contexte. Compte-rendu dès le premier soir.',
  },
  {
    title: 'La suite en régie',
    duration: tjm,
    text: 'Si la collaboration convient des deux côtés, on continue en régie, à temps plein ou partiel. Le compte-rendu du soir continue.',
  },
];

const modalites = [
  { label: 'Tarif', value: `${tjm} ou ${hourly}`, tone: 'tone-cyan' },
  { label: 'Rythme', value: 'Temps plein ou partiel', tone: 'tone-paper' },
  { label: 'Lieu', value: 'À distance, avec vos outils', tone: 'tone-orange' },
  { label: 'Présence', value: 'Tous les jours travaillés, en heures ouvrées', tone: 'tone-pale' },
];

const iaPoints = [
  {
    label: "Ce que l'IA fait",
    items: [
      'Explorer vite quand il faut comparer plusieurs approches.',
      'Le gros du volume sur ce qui est balisé et connu.',
      'Le code répétitif, les tests unitaires, les refactorings locaux.',
    ],
  },
  {
    label: 'Ce que je fais',
    items: [
      "J'écris ce que l'IA ne sait pas bien faire.",
      "Je valide les choix d'architecture et la cohérence d'ensemble.",
      'Je réponds du résultat : qualité, performance, stabilité, non-régression.',
    ],
  },
];
---

<SiteLayout
  title="Méthode"
  description={`Le compte-rendu écrit chaque soir, le déroulé d'une mission, les tarifs (${tjm} ou ${hourly}) et la place de l'IA dans mon travail.`}
  canonicalPath="/methode"
>
  <PageHero
    title={t('Comment je travaille,', { 'fr-MU': 'Kouma mo travay,' })}
    highlight={t('au jour le jour.')}
    lead="Le compte-rendu du soir, le déroulé d'une mission, les tarifs et la place de l'IA dans mon travail."
  />

  <section class="reports" aria-labelledby="cr-titre">
    <div class="wrap">
      <h2 class="display section-title" id="cr-titre" data-slam>
        {
          t('Chaque soir travaillé, un compte-rendu écrit.', {
            'fr-MU': 'Sak swar travay, enn rapor ekri.',
          })
        }
      </h2>
      <p class="lead reports-intro">
        Un message factuel, lu en 30 secondes. Quatre parties : ce qui est fait, ce qui bloque, ce
        qui suit, ce que j'attends de vous. Envoyé sur votre canal : Slack, mail ou Teams.
      </p>
      <div class="reports-grid">
        <figure data-tilt="-6,-1">
          <figcaption>Une journée normale</figcaption>
          <DailyReport
            meta={NOMINAL_REPORT.meta}
            done={NOMINAL_REPORT.done}
            upcoming={NOMINAL_REPORT.upcoming}
            decide={NOMINAL_REPORT.decide}
          />
        </figure>
        <figure data-tilt="6,1">
          <figcaption>Une journée avec un blocage</figcaption>
          <DailyReport
            meta={BLOCKED_REPORT.meta}
            done={BLOCKED_REPORT.done}
            blocked={BLOCKED_REPORT.blocked}
            upcoming={BLOCKED_REPORT.upcoming}
            stampMotion
          />
        </figure>
      </div>
      <div data-rise>
        <p class="reports-why">
          <strong>Pourquoi tous les jours ?</strong> Une réunion hebdomadaire vous dit ce qui s'est passé.
          Un compte-rendu quotidien vous permet d'arbitrer le jour même quand un blocage tombe.
        </p>
      </div>
    </div>
  </section>

  <Steps
    id="deroule"
    title={t("Le déroulé d'une mission", { 'fr-MU': 'Dérouléman enn mision' })}
    steps={phases}
  />

  <section class="modalites" aria-labelledby="modalites-titre" data-wipe="right">
    <div class="wrap">
      <h2 class="display section-title" id="modalites-titre" data-slam>
        {
          t('Les règles, posées dès le départ.', {
            'fr-MU': 'Bann régleman, klér depi koumansman.',
          })
        }
      </h2>
      <dl class="modalites-grid" data-rise>
        {
          modalites.map((item) => (
            <div class:list={['modalite', item.tone]}>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="ia" aria-labelledby="ia-titre">
    <div class="wrap ia-grid">
      <div>
        <h2 class="display section-title" id="ia-titre" data-slam>
          {t("L'IA écrit une partie du code. Je réponds du résultat.")}
        </h2>
        <p class="lead ia-intro">
          Coder avec une IA est devenu normal. La vraie question : qui garantit que le résultat
          tient dans la durée ? C'est mon travail.
        </p>
      </div>
      <div class="ia-cards" data-rise>
        {
          iaPoints.map((point, index) => (
            <div class:list={['ia-card', index === 1 && 'tone-cyan']}>
              <h3>{point.label}</h3>
              <ul>
                {point.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCta
    title={t('On commence par se parler.', { 'fr-MU': 'Nou komans par kozé.' })}
    text={`${RDV_DURATION_LABEL}, gratuit, sans engagement. Vous repartez avec mon avis sur votre projet.`}
    place="methode-final"
  />
</SiteLayout>

<style>
  .reports {
    padding-block: var(--space-section);
  }

  .reports-intro {
    margin-top: 20px;
  }

  .reports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px;
    align-items: start;
    margin-top: 48px;
  }

  figure {
    margin: 0;
  }

  figcaption {
    display: inline-block;
    margin-bottom: 14px;
    font-weight: 800;
    font-stretch: 110%;
    font-size: 1.1rem;
  }

  .reports-why {
    max-width: 44em;
    margin-top: 48px;
    font-size: 1.15rem;
  }

  .modalites {
    background: var(--paper-2);
    border-bottom: var(--border);
    padding-block: var(--space-section);
  }

  .modalites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .modalite {
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: 22px;
    box-shadow: var(--shadow-lg);
  }

  .modalite dt {
    font-weight: 700;
  }

  .modalite dd {
    margin: 8px 0 0;
    font-weight: 900;
    font-stretch: 112%;
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .ia {
    padding-block: var(--space-section);
  }

  .ia-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 40px clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .ia-intro {
    margin-top: 20px;
  }

  .ia-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }

  .ia-card {
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: 22px;
    background: var(--paper);
    box-shadow: var(--shadow-lg);
  }

  .ia-card.tone-cyan {
    background-color: var(--cyan);
  }

  .ia-card h3 {
    font-size: 1.2rem;
    font-weight: 800;
  }

  .ia-card ul {
    display: grid;
    gap: 8px;
    margin-top: 12px;
    padding-left: 1.1em;
    list-style: disc;
  }

  @media (max-width: 899px) {
    .ia-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

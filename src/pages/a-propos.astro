---
import { Image } from 'astro:assets';

import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import FinalCta from '../components/ui/FinalCta.astro';
import illustration from '../assets/pierre-illustration.png';
import photo from '../assets/pierre-photo.jpg';
import { COTON_URL, COTON_YEARS, EXPERIENCE_YEARS, FREELANCE_START_YEAR } from '../lib/site.const';
import { useLocale } from '../lib/i18n';

const { t, l } = useLocale(Astro.currentLocale);

const stack = [
  { label: 'Front', items: ['React', 'Angular', 'Next.js', 'Astro', 'Gatsby', 'MUI'] },
  { label: 'Back', items: ['NestJS', 'Node.js', 'GraphQL', 'Prisma', 'TypeORM', 'BullMQ', 'Go'] },
  { label: 'Données', items: ['PostgreSQL', 'SQL Server', 'Redis'] },
  {
    label: 'Infra',
    items: ['AWS (ECS, Amplify, Cognito, S3)', 'Terraform', 'Docker', 'GitHub Actions', 'Netlify'],
  },
  { label: 'Temps réel et IA', items: ['Socket.io', 'Agora', 'Agents LLM'] },
];
---

<SiteLayout
  title="À propos"
  description={`Développeur web depuis ${EXPERIENCE_YEARS} ans, freelance depuis ${FREELANCE_START_YEAR}, ${COTON_YEARS} ans à co-gérer un collectif de développeurs. Seul ou en équipe, je prends votre projet.`}
  canonicalPath="/a-propos"
>
  <PageHero
    title="Pierre,"
    highlight={t(`développeur depuis ${EXPERIENCE_YEARS} ans.`, {
      'fr-MU': `devlopper depi ${EXPERIENCE_YEARS} an.`,
    })}
    tone="orange"
  >
    <div class="intro" data-rise>
      <p>
        Pendant {COTON_YEARS} ans, j'ai co-fondé et co-géré
        <a class="link" href={COTON_URL} target="_blank" rel="noopener noreferrer">Coton</a>, un
        collectif de développeurs freelance, tout en continuant à coder chez les clients.
      </p>
      <p>
        Aujourd'hui je travaille en solo. Je prends des projets que je mène jusqu'à la production,
        avec un compte-rendu écrit chaque soir.
      </p>
    </div>
    <div class="portrait-case" slot="visual">
      <Image
        class="portrait printing"
        src={illustration}
        alt="Portrait illustré de Pierre Gordé"
        widths={[320, 480, 600]}
        sizes="(min-width: 900px) 440px, 90vw"
        loading="eager"
      />
    </div>
  </PageHero>

  <section class="stack" aria-labelledby="stack-titre">
    <div class="wrap">
      <h2 class="display section-title" id="stack-titre" data-slam>Ce que j'utilise en mission</h2>
      <p class="lead stack-intro">
        Relevé dans les projets livrés, pas dans une liste de mots-clés. Le détail est dans chaque <a
          class="link"
          href={l('/projets')}>fiche projet</a
        >.
      </p>
      <dl class="stack-grid" data-rise>
        {
          stack.map((group) => (
            <div class="stack-group">
              <dt>{group.label}</dt>
              <dd>
                <ul>
                  {group.items.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="solo" aria-labelledby="solo-titre" data-wipe="left">
    <div class="wrap solo-row">
      <div class="solo-visual" data-tilt="-8,-2">
        <Image
          class="solo-photo"
          src={photo}
          alt="Pierre Gordé sur un balcon, au coucher du soleil"
          widths={[320, 640]}
          sizes="320px"
          data-print
        />
      </div>
      <div>
        <h2 class="display section-title" id="solo-titre" data-slam>
          {t('Pourquoi le solo', { 'fr-MU': 'Kifer solo' })}
        </h2>
        <div class="solo-text" data-rise>
          <p>
            Dans un collectif, l'attention se partage entre les missions et la vie du collectif :
            recrutement, outils, stratégie commune. En solo, tout va au projet en cours.
          </p>
          <p>
            C'est aussi un choix de cadre : je décide de mes méthodes, de ce que je promets et de ce
            que je ne promets pas.
          </p>
          <p>
            De Coton, je garde une idée : être transparent sur le travail, le prix et les limites,
            dès le premier échange.
          </p>
        </div>
      </div>
    </div>
  </section>

  <FinalCta
    title={t('On se parle ?', { 'fr-MU': 'Nou kozé ?' })}
    text="Vous arrivez avec votre contexte, vous repartez avec mon avis, que vous travailliez avec moi ensuite ou non."
    place="a-propos-final"
  />
</SiteLayout>

<style>
  .intro {
    display: grid;
    gap: 14px;
    max-width: 36em;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .intro .link:hover {
    color: var(--ink);
  }

  .portrait-case {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: clamp(300px, 34vw, 460px);
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--cyan);
    background-image: var(--halftone-cyan);
    background-size: 9px 9px;
    box-shadow: var(--shadow-lg);
  }

  .portrait {
    display: block;
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom;
  }

  .stack {
    padding-block: var(--space-section);
  }

  .stack-intro {
    margin-top: 20px;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 28px 40px;
    margin-top: 40px;
  }

  .stack-group dt {
    font-weight: 900;
    font-stretch: 112%;
    font-size: 1.3rem;
  }

  .stack-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .stack-group dd {
    margin: 0;
  }

  .solo {
    background: var(--paper-2);
    border-block: var(--border);
  }

  .solo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
    padding-block: var(--space-section);
  }

  .solo-visual {
    flex: 0 0 auto;
    width: min(320px, 100%);
  }

  .solo-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .solo-row > div:last-child {
    flex: 1 1 420px;
    min-width: 0;
  }

  .solo-text {
    display: grid;
    gap: 16px;
    margin-top: 20px;
    max-width: 36em;
    font-size: 1.15rem;
  }
</style>

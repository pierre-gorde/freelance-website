---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { useLocale } from '../lib/i18n';

const { l } = useLocale(Astro.currentLocale);
---

<SiteLayout
  title="Posts"
  description="Des textes sur le développement TypeScript et la conduite de projet, quand j'ai quelque chose d'utile à dire."
  canonicalPath="/posts"
  noindex={true}
>
  <PageHero
    title="Rien de publié"
    highlight="pour l'instant."
    lead="J'écrirai ici quand un projet m'aura appris quelque chose d'utile à partager."
    tone="pale"
  >
    <a class="link" href={l('/projets')}>En attendant, les projets livrés</a>
  </PageHero>
</SiteLayout>

---
import { Image } from 'astro:assets';

import photo from '../../assets/pierre-photo.jpg';
import { COTON_YEARS, EXPERIENCE_YEARS } from '../../lib/site.const';
import { useLocale } from '../../lib/i18n';

const { l } = useLocale(Astro.currentLocale);

const stickers = [
  `${EXPERIENCE_YEARS} ans de TypeScript`,
  `${COTON_YEARS} ans chez Coton`,
  'Front et back',
];
---

<section class="about" id="qui" aria-labelledby="qui-titre">
  <div class="wrap about-row">
    <div class="about-visual">
      <div data-tilt="-10,-3">
        <Image
          class="about-photo"
          src={photo}
          alt="Pierre Gordé sur un balcon, au coucher du soleil"
          widths={[320, 640]}
          sizes="300px"
          data-print
        />
      </div>
      <ul class="stickers" aria-label="En bref" data-pop>
        {
          stickers.map((sticker, index) => (
            <li class={`sticker sticker--${index + 1}`}>{sticker}</li>
          ))
        }
      </ul>
    </div>
    <div class="about-text">
      <h2 class="display section-title" id="qui-titre" data-slam>Qui je suis</h2>
      <div data-rise>
        <p>
          {EXPERIENCE_YEARS} ans de TypeScript, front et back. J'ai co-fondé et co-géré pendant {
            COTON_YEARS
          } ans le collectif de freelances Coton.
        </p>
        <p>
          Ma stack principale : React, Angular, NestJS, PostgreSQL, AWS et Terraform. Je travaille à
          distance, avec vos outils.
        </p>
        <p><a class="link" href={l('/a-propos')}>Mon parcours</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    overflow-x: clip;
  }

  .about-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
    padding-block: clamp(64px, 8vw, 112px);
  }

  .about-visual {
    position: relative;
    flex: 0 0 auto;
    width: min(300px, 100%);
  }

  .about-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .sticker {
    position: absolute;
    z-index: 2;
    border: var(--border);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    box-shadow: var(--shadow-sm);
    font-weight: 800;
    font-stretch: 110%;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .sticker--1 {
    top: -16px;
    right: -22px;
    background: var(--cyan);
    rotate: 6deg;
  }

  .sticker--2 {
    bottom: 40px;
    left: -20px;
    background: var(--orange);
    rotate: -5deg;
  }

  .sticker--3 {
    bottom: -18px;
    right: 6px;
    background: var(--paper);
    rotate: 3deg;
  }

  .about-text {
    flex: 1 1 420px;
    min-width: 0;
  }

  [data-rise] {
    display: grid;
    gap: 18px;
    margin-top: 18px;
    font-size: 1.15rem;
    max-width: 36em;
  }

  @media (max-width: 699px) {
    .sticker--1 {
      right: -6px;
    }

    .sticker--2 {
      left: -6px;
    }
  }
</style>

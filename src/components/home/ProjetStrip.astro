---
import ProjetCard from '../projets/ProjetCard.astro';
import { HOME_PROJET_SLUGS, PROJETS, getProjet } from '../../lib/projets.const';
import { useLocale } from '../../lib/i18n';

const { t, l } = useLocale(Astro.currentLocale);

const featured: readonly string[] = HOME_PROJET_SLUGS;
const highlighted = HOME_PROJET_SLUGS.map((slug) => getProjet(slug));
const others = PROJETS.filter((projet) => !featured.includes(projet.slug));
const allLabel = t(`Voir les ${PROJETS.length} projets`, {
  'fr-MU': `Get ${PROJETS.length} proze`,
});
---

<section class="strip" id="projets" aria-labelledby="projets-titre" data-strip>
  <div class="wrap">
    <div class="strip-head">
      <h2 class="display section-title" id="projets-titre" data-slam>
        {t('Des projets livrés', { 'fr-MU': 'Bann proze livré' })}
      </h2>
      <p class="strip-hint">La bande avance quand vous faites défiler.</p>
      <a class="link" href={l('/projets')}>{allLabel}</a>
    </div>
    <div class="strip-stage">
      <ol class="strip-track" data-strip-track>
        {highlighted.map((projet) => <ProjetCard projet={projet} stampMotion={false} />)}
        <li class="panel-more tone-cyan">
          <span class="stamp">Et aussi</span>
          <ul>
            {
              others.map((projet) => (
                <li>
                  <a href={l(`/projets/${projet.slug}`)}>{projet.titre}</a>
                </li>
              ))
            }
          </ul>
          <a class="btn" href={l('/projets')}>{allLabel}</a>
        </li>
      </ol>
    </div>
    <div class="strip-progress" aria-hidden="true"><span data-strip-progress></span></div>
  </div>
</section>

<style>
  .strip {
    padding-block: var(--space-section);
    overflow: hidden;
  }

  .strip-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .strip-hint {
    display: none;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .strip-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
    margin-top: 36px;
  }

  .panel-more {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px;
    border: var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .panel-more ul {
    display: grid;
    gap: 4px;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .panel-more ul a {
    text-decoration: none;
  }

  .panel-more ul a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 3px;
  }

  .panel-more .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  .strip-progress {
    display: none;
    height: 6px;
    margin-top: 28px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-pill);
  }

  .strip-progress span {
    display: block;
    height: 100%;
    background: var(--orange);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /* Bande épinglée (desktop, animations actives) : les cases défilent à l'horizontale,
     toutes à la même hauteur. */
  :global(.is-pinned) .strip {
    padding-block: 28px 36px;
  }

  :global(.is-pinned) .strip-hint,
  :global(.is-pinned) .strip-progress {
    display: block;
  }

  :global(.is-pinned) .strip-track {
    display: flex;
    align-items: stretch;
    gap: 28px;
    width: max-content;
    margin-top: 24px;
  }

  :global(.is-pinned) .strip-track > :global(li) {
    width: min(500px, 60vw);
  }

  /* Cartes côte à côte : même hauteur. Empilées sur mobile : chacune sa hauteur. */
  @media (min-width: 800px) {
    .strip-track {
      grid-auto-rows: 1fr;
    }
  }
</style>

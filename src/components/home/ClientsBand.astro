---
import { EVENT_CLIENT } from '../../lib/analytics.const';
import { HOME_PROJET_SLUGS, PROJETS } from '../../lib/projets.const';
import { useLocale } from '../../lib/i18n';

const { l } = useLocale(Astro.currentLocale);

const featured: readonly string[] = HOME_PROJET_SLUGS;
const clients = [
  ...PROJETS.filter((projet) => featured.includes(projet.slug)).sort(
    (a, b) => featured.indexOf(a.slug) - featured.indexOf(b.slug)
  ),
  ...PROJETS.filter((projet) => !featured.includes(projet.slug)),
];
const copies = [false, true];
---

<section class="clients" aria-labelledby="clients-titre">
  <div class="wrap clients-row">
    <h2 class="clients-label" id="clients-titre">Ils m'ont confié un projet</h2>
    <div class="marquee" data-marquee>
      <div class="marquee-track" data-marquee-track>
        {
          copies.map((isCopy) => (
            <ul class="marquee-item" aria-hidden={isCopy ? 'true' : undefined}>
              {clients.map((projet) => (
                <li>
                  <a
                    href={l(`/projets/${projet.slug}`)}
                    tabindex={isCopy ? -1 : undefined}
                    data-umami-event={EVENT_CLIENT}
                    data-umami-event-slug={projet.slug}
                  >
                    {projet.client}
                  </a>
                  <span class="sep" aria-hidden="true">
                    /
                  </span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .clients {
    background: var(--ink);
    color: var(--paper);
    border-block: var(--border);
  }

  .clients-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding-block: 18px;
  }

  .clients-label {
    flex: 0 0 auto;
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--cyan);
  }

  .marquee {
    flex: 1 1 400px;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 5%, black 95%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  :global(.js-marquee) .marquee-track {
    animation: none;
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: flex;
    white-space: nowrap;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.2rem;
  }

  .marquee-item li {
    display: flex;
  }

  .marquee-item a {
    text-decoration: none;
    border-radius: var(--radius-sm);
    padding-inline: 2px;
  }

  .marquee-item a:hover {
    color: var(--orange);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 3px;
  }

  .marquee-item a:focus-visible {
    outline-color: var(--cyan);
  }

  .sep {
    color: var(--orange);
    padding-inline: 0.45em;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .marquee-track {
      animation: none;
      width: auto;
    }

    .marquee-item {
      flex-wrap: wrap;
      white-space: normal;
      row-gap: 4px;
    }

    .marquee-item[aria-hidden='true'] {
      display: none;
    }
  }
</style>

---
import CopyEmail from './CopyEmail.astro';
import PrimaryCta from './PrimaryCta.astro';
import { useLocale } from '../../lib/i18n';
import { frenchSpacing } from '../../lib/typo';

type Props = {
  title: string;
  text?: string;
  place: string;
};

const { title, text, place } = Astro.props;
const { t } = useLocale(Astro.currentLocale);

const BURST_POINTS =
  '100.0,2.0 114.4,27.4 137.5,9.5 141.1,38.5 169.3,30.7 161.5,58.9 190.5,62.5 172.6,85.6 198.0,100.0 172.6,114.4 190.5,137.5 161.5,141.1 169.3,169.3 141.1,161.5 137.5,190.5 114.4,172.6 100.0,198.0 85.6,172.6 62.5,190.5 58.9,161.5 30.7,169.3 38.5,141.1 9.5,137.5 27.4,114.4 2.0,100.0 27.4,85.6 9.5,62.5 38.5,58.9 30.7,30.7 58.9,38.5 62.5,9.5 85.6,27.4';
---

<section class="final" id="rdv" aria-labelledby="rdv-titre" data-wipe="diag">
  <div class="wrap final-row">
    <div>
      <h2 class="display final-title" id="rdv-titre" data-slam>{frenchSpacing(title)}</h2>
      {text && <p class="final-text">{frenchSpacing(text)}</p>}
      <p class="final-mail">
        {t('Ou écrivez-moi :', { 'fr-MU': 'Ouswa ekrir mwa :' })}
        <CopyEmail strong />
      </p>
    </div>
    <div class="final-cta">
      <svg class="burst" viewBox="0 0 200 200" aria-hidden="true" data-burst>
        <polygon points={BURST_POINTS}></polygon>
      </svg>
      <PrimaryCta
        size="lg"
        tone="ink"
        place={place}
        magnet
        burstTrigger
        label={t('Réserver un échange', { 'fr-MU': 'Nou kozé ?' })}
      />
    </div>
  </div>
</section>

<style>
  .final {
    background-color: var(--orange);
    background-image: var(--halftone-orange);
    background-size: var(--halftone-size) var(--halftone-size);
    border-block: var(--border);
  }

  .final-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    padding-block: var(--space-section);
  }

  .final-title {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.2rem, 1.3rem + 3vw, 4rem);
  }

  .final-text {
    margin-top: 18px;
    max-width: 32em;
    font-size: var(--text-lead);
    font-weight: 600;
  }

  .final-mail {
    margin-top: 16px;
    font-weight: 700;
  }

  .final-mail :global(a) {
    text-underline-offset: 4px;
  }

  .final-cta {
    position: relative;
    display: grid;
    place-items: center;
    width: 300px;
    height: 300px;
    max-width: 100%;
  }

  .final-cta :global(.magnet) {
    position: relative;
    z-index: 1;
  }

  .burst {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .burst polygon {
    fill: var(--cyan);
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }
</style>

---
import { CAL_EVENT_LINK, CAL_NAMESPACE, RDV_DURATION_SHORT } from '../../lib/site.const';
import { EVENT_CTA_RDV } from '../../lib/analytics.const';
import { useLocale } from '../../lib/i18n';

type Props = {
  size?: 'sm' | 'md' | 'lg';
  tone?: 'orange' | 'ink';
  label?: string;
  /** Libellé réduit sous 700 px (header mobile). */
  shortLabel?: string;
  /** Emplacement remonté dans l'événement Umami, pour savoir quel bouton fait réserver. */
  place: string;
  magnet?: boolean;
  burstTrigger?: boolean;
  class?: string;
};

const { t } = useLocale(Astro.currentLocale);

const {
  size = 'md',
  tone = 'orange',
  label = t(`Réserver un échange de ${RDV_DURATION_SHORT}`, {
    'fr-MU': `Nou kozé ${RDV_DURATION_SHORT} ?`,
  }),
  shortLabel,
  place,
  magnet = false,
  burstTrigger = false,
  class: className,
} = Astro.props;

const classes = ['btn', size !== 'md' && `btn-${size}`, tone === 'ink' && 'btn-ink', className];
---

<span class="magnet" data-magnet={magnet ? '' : undefined}>
  <button
    type="button"
    class:list={classes}
    data-cal-link={CAL_EVENT_LINK}
    data-cal-namespace={CAL_NAMESPACE}
    data-umami-event={EVENT_CTA_RDV}
    data-umami-event-place={place}
    data-burst-trigger={burstTrigger ? '' : undefined}
    aria-label={shortLabel ? label : undefined}
  >
    {
      shortLabel ? (
        <>
          <span class="cta-long" aria-hidden="true">
            {label}
          </span>
          <span class="cta-short" aria-hidden="true">
            {shortLabel}
          </span>
        </>
      ) : (
        label
      )
    }
  </button>
</span>

<style>
  .cta-short {
    display: none;
  }

  @media (max-width: 699px) {
    .cta-long {
      display: none;
    }

    .cta-short {
      display: inline;
    }
  }
</style>

---
import SlamTitle from './SlamTitle.astro';
import { frenchSpacing } from '../../lib/typo';

type Props = {
  title: string;
  highlight?: string;
  lead?: string;
  tone?: 'paper' | 'cyan' | 'orange' | 'pale' | 'ink';
};

const { title, highlight, lead, tone = 'paper' } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---

<section class:list={['page-hero', tone !== 'paper' && `tone-${tone}`]}>
  <div class:list={['wrap', 'page-hero-grid', hasVisual && 'has-visual']}>
    <div class="page-hero-copy">
      <slot name="before" />
      <SlamTitle class="page-hero-title" text={title} highlight={highlight} />
      {lead && <p class="lead page-hero-lead">{frenchSpacing(lead)}</p>}
      <slot />
    </div>
    {
      hasVisual && (
        <div class="page-hero-visual">
          <slot name="visual" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    border-bottom: var(--border);
    overflow-x: clip;
  }

  .page-hero-grid {
    display: grid;
    gap: 40px clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 5vw, 80px) clamp(48px, 6vw, 88px);
  }

  .page-hero-grid.has-visual {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }

  .page-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .page-hero-copy :global(.page-hero-title) {
    margin: 0;
    max-width: 16ch;
    font-size: var(--text-h1);
  }

  .page-hero-lead {
    max-width: 38em;
  }

  .page-hero-visual {
    min-width: 0;
  }

  @media (max-width: 899px) {
    .page-hero-grid.has-visual {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

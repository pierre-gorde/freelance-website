---
type Step = { title: string; text: string; duration?: string };

type Props = {
  id: string;
  title: string;
  steps: readonly Step[];
  /** Ligne posée sous les étapes (tarifs). */
  footnote?: string;
  tone?: 'paper' | 'plain';
};

const { id, title, steps, footnote, tone = 'paper' } = Astro.props;
---

<section class:list={['steps', `steps--${tone}`]} id={id} aria-labelledby={`${id}-titre`}>
  <div class="wrap">
    <h2 class="display section-title" id={`${id}-titre`} data-slam>{title}</h2>
    <div class="steps-line" aria-hidden="true" data-line></div>
    <ol class="steps-list" data-flip>
      {
        steps.map((step, index) => (
          <li class="step">
            <p class="step-n" data-pop>
              {index + 1}
            </p>
            <h3>{step.title}</h3>
            {step.duration && <p class="step-duration">{step.duration}</p>}
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
    {
      footnote && (
        <p class="steps-footnote" data-stamp>
          {footnote}
        </p>
      )
    }
    <slot />
  </div>
</section>

<style>
  .steps {
    padding-block: var(--space-section);
  }

  .steps--paper {
    background: var(--paper-2);
    border-block: var(--border);
  }

  .steps-line {
    height: 4px;
    margin-top: 36px;
    background: var(--ink);
    border-radius: 4px;
    transform-origin: 0 50%;
  }

  .steps-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 24px;
    margin-top: 24px;
    perspective: 1400px;
  }

  .step {
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: 22px;
    box-shadow: var(--shadow-lg);
  }

  .step:nth-child(4n + 1) {
    rotate: -1deg;
  }

  .step:nth-child(4n + 2) {
    rotate: 0.7deg;
  }

  .step:nth-child(4n + 3) {
    rotate: -0.5deg;
  }

  .step:nth-child(4n + 4) {
    rotate: 0.9deg;
  }

  .step-n {
    display: inline-block;
    font-size: 2.6rem;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1;
    color: var(--orange-ink);
  }

  .step h3 {
    margin-top: 12px;
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .step-duration {
    margin-top: 6px;
    font-weight: 700;
    color: var(--orange-ink);
  }

  .step p:last-child {
    margin-top: 8px;
  }

  .steps-footnote {
    display: inline-block;
    margin-top: 36px;
    border: var(--border);
    border-radius: var(--radius-md);
    padding: 10px 16px;
    background: var(--cyan);
    box-shadow: var(--shadow-md);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem);
    font-weight: 800;
    rotate: -1deg;
  }
</style>

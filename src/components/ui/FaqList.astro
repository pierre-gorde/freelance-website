---
import { frenchSpacing } from '../../lib/typo';

export type FaqItem = { question: string; answer: string };

type Props = {
  items: readonly FaqItem[];
  headingLevel?: 'h2' | 'h3';
};

const { items, headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="faq" data-rise>
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>
          <Heading class="faq-question">{frenchSpacing(item.question)}</Heading>
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <p class="faq-answer" set:html={frenchSpacing(item.answer)} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 16px;
  }

  .faq-item {
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }

  .faq-item[open] {
    box-shadow: var(--shadow-lg);
  }

  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border: var(--border);
    border-radius: 50%;
    background: var(--cyan);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    background: var(--ink);
    translate: -50% -50%;
  }

  .faq-icon::after {
    rotate: 90deg;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background: var(--orange);
  }

  .faq-answer {
    padding: 0 22px 22px;
    max-width: 70ch;
    font-size: 1.05rem;
  }

  .faq-answer :global(a) {
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-icon {
      transition: none;
    }
  }
</style>

---
import LocaleSwitcher from './LocaleSwitcher.astro';
import CopyEmail from '../ui/CopyEmail.astro';
import { PERSONA_LINKS, PRIMARY_NAV_LINKS } from '../../lib/links.const';
import { GITHUB_URL, LINKEDIN_URL, SITE_NAME, SOURCE_CODE_URL } from '../../lib/site.const';
import { EVENT_GITHUB, EVENT_LINKEDIN, EVENT_SOURCE_CODE } from '../../lib/analytics.const';
import { useLocale } from '../../lib/i18n';

const { t, l } = useLocale(Astro.currentLocale);

const wordmarkLetters = [...SITE_NAME];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-pitch">
      <p>
        Pas d'équipe tech en place ? Je cadre et je livre aussi des projets complets.
        <a class="link" href={l('/sans-equipe-tech')}>Voir comment</a>
      </p>
      <p>
        <CopyEmail class="link" />
      </p>
    </div>

    <nav aria-label="Plan du site">
      <ul>
        {
          PRIMARY_NAV_LINKS.map((link) => (
            <li>
              <a href={l(link.href)}>{t(link.label, link.labelOverrides)}</a>
            </li>
          ))
        }
        {
          PERSONA_LINKS.map((link) => (
            <li>
              <a href={l(link.href)}>{t(link.label, link.labelOverrides)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="footer-elsewhere">
      <li>
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event={EVENT_LINKEDIN}>LinkedIn</a
        >
      </li>
      <li>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event={EVENT_GITHUB}>GitHub</a
        >
      </li>
      <li>
        <a
          href={SOURCE_CODE_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event={EVENT_SOURCE_CODE}>Code source du site</a
        >
      </li>
      <li><a href={l('/mentions-legales')}>Mentions légales</a></li>
      <li class="footer-locales"><LocaleSwitcher /></li>
    </ul>
  </div>

  <p class="wordmark" aria-hidden="true" data-wordmark>
    {
      wordmarkLetters.map((letter) => (
        <span class="wm-letter">{letter === ' ' ? ' ' : letter}</span>
      ))
    }
  </p>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    border-top: var(--border);
    background: var(--paper);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px 48px;
    padding-block: 48px 32px;
  }

  .footer-pitch {
    display: grid;
    gap: 16px;
    align-content: start;
    font-size: 1.1rem;
    max-width: 30em;
  }

  ul {
    display: grid;
    gap: 8px;
    align-content: start;
    font-weight: 700;
  }

  nav a,
  .footer-elsewhere a:not([data-umami-event='locale-switch']) {
    text-decoration: none;
  }

  nav a:hover,
  .footer-elsewhere a:not([data-umami-event='locale-switch']):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .footer-locales {
    padding-top: 8px;
  }

  .wordmark {
    display: flex;
    justify-content: center;
    margin: 0;
    padding-inline: var(--gutter);
    overflow: hidden;
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(2.5rem, 11vw, 11rem);
    line-height: 0.82;
    letter-spacing: -0.02em;
    color: var(--orange);
    -webkit-text-stroke: 2px var(--ink);
    white-space: pre;
    user-select: none;
  }

  .wm-letter {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  @media (max-width: 899px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer-pitch {
      grid-column: 1 / -1;
    }
  }
</style>

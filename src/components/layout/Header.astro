---
import { Image } from 'astro:assets';

import PrimaryCta from '../ui/PrimaryCta.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';
import avatar from '../../assets/pierre-avatar.png';
import { PRIMARY_NAV_LINKS } from '../../lib/links.const';
import { SITE_NAME, SITE_ROLE } from '../../lib/site.const';
import { stripLocalePrefix, useLocale } from '../../lib/i18n';

const { t, l } = useLocale(Astro.currentLocale);

const currentPath = stripLocalePrefix(Astro.url.pathname);
const isActive = (href: string): boolean =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<a class="skip-link" href="#contenu">Aller au contenu</a>

<header class="site-header" id="site-header">
  <div class="wrap header-row">
    <a class="brand" href={l('/')} aria-label={`${SITE_NAME}, accueil`}>
      <Image class="brand-avatar" src={avatar} alt="" width={36} height={36} densities={[1, 2]} />
      <span class="brand-name">{SITE_NAME}</span>
      <span class="brand-role">{SITE_ROLE}</span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul>
        {
          PRIMARY_NAV_LINKS.map((link) => (
            <li>
              <a href={l(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
                {t(link.label, link.labelOverrides)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <PrimaryCta
        size="sm"
        place="header"
        label={t('Réserver un échange', { 'fr-MU': 'Nou kozé ?' })}
        shortLabel="Réserver"
      />
      <button
        id="mobile-menu-btn"
        class="burger"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="page-progress" aria-hidden="true"><span data-page-progress></span></div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Navigation mobile" hidden>
    <ul class="wrap">
      {
        PRIMARY_NAV_LINKS.map((link) => (
          <li>
            <a href={l(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
              {t(link.label, link.labelOverrides)}
            </a>
          </li>
        ))
      }
      <li class="mobile-locales"><LocaleSwitcher /></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: var(--border);
    view-transition-name: site-header;
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-avatar {
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    border: var(--border);
    background: var(--orange);
  }

  .brand-name {
    font-weight: 800;
    font-stretch: 115%;
    font-size: 1.05rem;
  }

  .brand-role {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .brand-role::before {
    content: '·';
    margin-right: 8px;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 22px;
    font-weight: 700;
  }

  .nav a {
    text-decoration: none;
    padding-block: 6px;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--orange);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .burger {
    display: none;
    width: 40px;
    height: 40px;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--paper);
    cursor: pointer;
  }

  .burger span,
  .burger span::before,
  .burger span::after {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--ink);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .burger span {
    position: relative;
  }

  .burger span::before,
  .burger span::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger span::before {
    top: -6px;
  }

  .burger span::after {
    top: 6px;
  }

  .burger[aria-expanded='true'] span {
    background: transparent;
  }

  .burger[aria-expanded='true'] span::before {
    transform: translateY(6px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .page-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 4px;
    pointer-events: none;
  }

  .page-progress span {
    display: block;
    height: 100%;
    background: var(--orange);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--paper);
    border-bottom: var(--border);
    box-shadow: 0 6px 0 var(--ink);
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    padding-block: 8px 16px;
  }

  .mobile-menu a {
    display: block;
    padding-block: 12px;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.4rem;
    text-decoration: none;
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--orange-ink);
  }

  .mobile-locales {
    padding-top: 8px;
  }

  @media (max-width: 1099px) {
    .brand-role {
      display: none;
    }
  }

  @media (max-width: 859px) {
    .nav {
      display: none;
    }

    .burger {
      display: grid;
      place-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger span,
    .burger span::before,
    .burger span::after {
      transition: none;
    }
  }
</style>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!button || !menu) return;
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
  };

  button?.addEventListener('click', () => setOpen(menu?.hidden === true));
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      button?.focus();
    }
  });
</script>
